{
  "name": "root",
  "version": "2.0.0",
  "private": true,
  "workspaces": ["wglt", "docs"],
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "dev": "npm run dev --workspace=docs",
