{
  "name": "root",
  "version": "2.0.0-beta.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "dev": "npm run dev --workspace=wglt-docs",
    "fix": "biome check --write --unsafe .",
    "lint": "biome check .",
    "preview": "npm run preview --workspace=wlgt-docs",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@types/node": "25.0.3",
    "rimraf": "6.1.2",
    "turbo": "2.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "npm@10.9.0",
  "madge": {
    "detectiveOptions": {
      "ts": {
        "skipTypeImports": true
      }
    }
  }
}
