{
  "name": "wglt",
  "version": "2.0.0-beta.1",
  "description": "A WebGL2 game engine for roguelikes and turn-based games",
  "license": "MIT",
  "author": "Cody Ebberson",
  "homepage": "https://github.com/codyebberson/wglt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codyebberson/wglt.git",
    "directory": "packages/wglt"
  },
  "keywords": [
    "wglt",
    "webgl",
    "webgl2",
    "game-engine",
    "roguelike",
    "ascii",
    "tilemap"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "prepack": "npm run build",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "typescript": "7.0.2"
  },
  "madge": {
    "detectiveOptions": {
      "ts": {
        "skipTypeImports": true
      }
    }
  }
}
